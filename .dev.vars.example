# 生产参数在 Cloudflare Pages 项目的 Variables and Secrets 中配置。
# 请勿在此文件填写真实密钥，也不要使用 VITE_ 前缀。
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_CONTAINER=blog
AZURE_STORAGE_ACCOUNT_KEY=your-secret-account-key
GITHUB_CLIENT_ID=your-oauth-client-id
GITHUB_CLIENT_SECRET=your-oauth-client-secret
# infernoxxa 的固定 GitHub 用户 ID，不使用可修改的用户名鉴权。
ADMIN_GITHUB_ID=189717213
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# 默认正式域名；只有更换域名或独立预览 OAuth 应用时才需要设置。
GITHUB_OAUTH_ORIGIN=https://xxxinferno.me
