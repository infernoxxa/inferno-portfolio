{
  "name": "inferno-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "tsx scripts/preview.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:articles": "tsx scripts/check-articles.ts",
    "check:functions": "wrangler pages functions build --outdir .local-data/functions-build"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.17",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/server-renderer": "^3.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.1.0",
    "wrangler": "^4.161.0"
  }
}
